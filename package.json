{
  "name": "LNvoucher-maker",
  "version": "1.0.0",
  "description": "Offline voucher PDF generator",
  "author": "LN software",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/run-electron.js .",
    "test:smoke": "node scripts/run-electron.js tests/smoke.js",
    "seed:website": "node scripts/run-electron.js . --seed-website-catalog",
    "sync:now": "node scripts/run-electron.js . --sync-now",
    "rebuild:electron": "electron-builder install-app-deps",
    "prepare:bundle-settings": "node scripts/prepare-bundled-settings.js",
    "pack": "npm run prepare:bundle-settings && electron-builder --dir",
    "pack:mac:arm": "npm run prepare:bundle-settings && electron-builder --dir --mac --arm64",
    "pack:win": "npm run prepare:bundle-settings && electron-builder --dir --win --x64",
    "dist": "npm run prepare:bundle-settings && electron-builder --mac --arm64 --win --x64",
    "dist:mac:arm": "npm run prepare:bundle-settings && electron-builder --mac --arm64",
    "dist:win": "npm run prepare:bundle-settings && electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.voucher.maker",
    "productName": "LN software",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "npmRebuild": true,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "templates/**/*",
      "node_modules/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "build/settings.json",
        "to": "settings.json"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    }
  }
}
