{
  "name": "LNvoucher-maker",
  "version": "1.0.0",
  "description": "Offline voucher PDF generator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:smoke": "electron tests/smoke.js",
    "pack": "electron-builder --dir --win",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {

    "electron": "^39.8.5",
    "electron-builder": "^26.8.1"

  },
  "build": {
    "appId": "com.voucher.maker",
    "productName": "LN software",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "templates/**/*",
      "node_modules/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "templates",
        "to": "templates"
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false
    }
  }
}
